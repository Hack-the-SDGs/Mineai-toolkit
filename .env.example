# mineai-toolkit dev/test credentials.
#
# Copy to `.env` in this same folder (it is git-ignored) and fill in the values.
# Read once at MCP server startup by main.py, so restart opencode after editing.
#
# Only used when you create a bot WITHOUT an account shorthand. Camp machines
# using create_bot("g_swim") ignore this file entirely.
#
# Register the account first at https://drash.ntust.camp/en/login

MC_USERNAME=your_bot_username
MC_PASSWORD=your_bot_password

# Server. MC_PORT matters: the camp server is NOT on the default 25565.
MC_HOST=mc.ntust.camp
MC_PORT=50213

# Drasl authentication. Leave as-is for the camp server.
MC_AUTH=mojang
MC_AUTH_SERVER=https://drasl.ntust.camp/auth
MC_SESSION_SERVER=https://drasl.ntust.camp/session

# Must be a version mineflayer supports (currently up to 1.21.11).
MC_VERSION=1.21.11
