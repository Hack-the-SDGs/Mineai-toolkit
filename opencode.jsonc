{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "HackTheSDGs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HackTheSDGs",
      "options": {
        "baseURL": "YOUR_SSH_FORWARDING_URL_PLUS_PORT",
        "apiKey": "dummy" // WIll have actual api-key when camp  
      },
      "models": {
        "Qwen3.6-27B-UD-Q4_K_XL": {
          "name": "HackTheSDGs",
        }
      }
    }
  },
  "mcp": {
    "mine-ai-toolkit-mcp-server": {
      "type": "local",
      "command": [
        "YOUR_PYTHON_PATH",
        "YOUR_MINEAI_PATH"
      ],
      "enabled": true
    }
  }
}
